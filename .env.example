# 이 파일을 복사해 이름을 .env 로 바꾼 뒤 값을 채워 주세요.
# .env 파일은 절대 남에게 보내거나 깃허브에 올리지 마세요.
NAVER_ID=your_id@naver.com
NAVER_APP_PASSWORD=your_naver_app_password

# ── 정리 방법 고르기 (한 줄만 남기고 나머지는 앞에 # 를 붙이세요) ──
AI_PROVIDER=keyword          # 돈 0원 · AI 없이 낱말 규칙으로 분류 (가장 쉬움)
# AI_PROVIDER=ollama         # 돈 0원 · 내 PC 안의 AI, 메일이 밖으로 안 나감
# AI_PROVIDER=gemini         # 무료 키 · 구글 AI Studio (무료 등급은 입력이 구글 개선에 쓰일 수 있음)
# AI_PROVIDER=codex          # ChatGPT 구독 사용량 · Codex CLI 로그인 필요
# AI_PROVIDER=openai         # 유료 API
# AI_PROVIDER=anthropic      # 유료 API
# AI_PROVIDER=mock           # 시험용 (AI 없이 고정 문구)

# gemini / openai / anthropic 일 때만 필요 (keyword·ollama·codex는 비워 두세요)
AI_API_KEY=

# 모델 이름 (비워 두면 기본값)
#   ollama: qwen2.5:7b · gemini: gemini-3.5-flash-lite
#   openai: gpt-6-luna · anthropic: claude-haiku-5-5
# AI_MODEL=

# Ollama 주소 (보통 바꿀 필요 없음)
# OLLAMA_URL=http://localhost:11434
